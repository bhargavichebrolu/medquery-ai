# Copy to `.env` and adjust. `.env` is git-ignored; never commit real values.
# All variables are optional; defaults are shown. Relative paths are resolved
# against the repository root.

# Read-only dissertation research archive (notebooks, data, original results).
MEDQUERY_ARCHIVE_DIR=Healthcare_RAG

# Project documentation, including the baseline checksum manifest.
MEDQUERY_DOCS_DIR=docs

# Output folder for newly executed experiments (kept separate from the archive).
MEDQUERY_EXPERIMENTS_DIR=experiments

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
MEDQUERY_LOG_LEVEL=INFO

# Embedding device: auto (CUDA if available, else CPU), cpu, or cuda.
# Known issue: CUDA inference currently fails on the development machine (RTX 4060,
# driver 610.62); set cpu there. See docs/embeddings/EMBEDDINGS.md section 6.
MEDQUERY_EMBEDDING_DEVICE=auto

# Opt-in tests that load real embedding models from the local Hugging Face cache.
# They never download weights; run backend/scripts/analyse_embedding_models.py once to fetch them.
# MEDQUERY_RUN_MODEL_TESTS=1

# Standard Hugging Face variables (optional):
# HF_HOME=          # model cache location (default: ~/.cache/huggingface)
# HF_HUB_OFFLINE=1  # forbid all downloads
# No Hugging Face token is needed: all four embedding models are public.
